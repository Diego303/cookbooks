---
/**
 * Standalone whiteboard page — loaded inside an iframe.
 * No Layout, no global CSS. 100% clean environment for Excalidraw.
 */
import Whiteboard from '../components/Whiteboard.jsx';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Canvas</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>👨‍🍳</text></svg>" />
    <style>
      html, body, #app {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
      }
    </style>
  </head>
  <body>
    <div id="app">
      <Whiteboard client:only="react" />
    </div>
  </body>
</html>
