---
/**
 * [slug].astro — Dynamic route for individual documentation pages.
 * Fetches the MDX entry from the docs content collection and renders
 * it inside the DocLayout with sidebar TOC, breadcrumbs, etc.
 */
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import CodeBlockShiki from '../../components/CodeBlockShiki.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<DocLayout
  title={entry.data.title}
  description={entry.data.description}
  intro={entry.data.intro}
  breadcrumb={entry.data.breadcrumb}
  toc={entry.data.toc}
>
  <Content components={{ pre: CodeBlockShiki }} />
</DocLayout>
