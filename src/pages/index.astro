---
/**
 * index.astro — Main single-page entry point.
 *
 * Orchestrates two visual "modes":
 *   LANDING MODE: Hero → Library → Footer  (default)
 *   DOC MODE:     Full-page DocViewer       (when a card is selected)
 *
 * Transitions feel like navigating to a new page,
 * but everything lives in a single HTML document.
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Library from '../components/Library.astro';
import DocViewer from '../components/DocViewer.astro';
import Canvas from '../components/Canvas.astro';
import Footer from '../components/Footer.astro';
import { topics } from '../data/topics';
---

<Layout>
  <Nav />

  <!-- Landing sections (hidden when doc is open) -->
  <div id="landing-sections">
    <Hero />
    <Library />
    <Footer />
  </div>

  <!-- Doc viewer (hidden by default, shown as full page) -->
  <DocViewer />

  <!-- Canvas / Whiteboard (hidden by default) -->
  <Canvas />

  <!-- Topic metadata for client-side JS -->
  <script
    type="application/json"
    id="topics-json"
    set:html={JSON.stringify(
      topics.map(t => ({
        id: t.id,
        title: t.title,
        breadcrumb: t.breadcrumb,
        toc: t.toc,
      }))
    )}
  />
</Layout>

<script is:inline>
/**
 * Page Controller
 * Manages transitions between Landing Mode and Doc Mode.
 */
(function () {
  // --- DOM References ---
  const landingSections = document.getElementById('landing-sections');
  const docViewer       = document.getElementById('doc-viewer');
  const canvasSection   = document.getElementById('canvas-section');
  const navLanding      = document.getElementById('nav-landing');
  const navDoc          = document.getElementById('nav-doc');
  const navBreadcrumb   = document.getElementById('nav-breadcrumb');
  const navBack         = document.getElementById('nav-back');
  const navLogo         = document.getElementById('nav-logo');
  const navToggle       = document.getElementById('nav-toggle');
  const docBreadcrumbs  = document.getElementById('doc-breadcrumbs');
  const docBackSidebar  = document.getElementById('doc-back-sidebar');
  const docBackBottom   = document.getElementById('doc-back-bottom');
  const canvasBack      = document.getElementById('canvas-back');
  const canvasIframe    = document.getElementById('canvas-iframe');

  // Mobile TOC elements
  const mobileTocBtn     = document.getElementById('doc-mobile-toc-btn');
  const mobileTocPanel   = document.getElementById('doc-mobile-toc-panel');
  const mobileTocOverlay = document.getElementById('doc-mobile-toc-overlay');
  const mobileTocClose   = document.getElementById('doc-mobile-toc-close');

  const topicsMeta = JSON.parse(
    document.getElementById('topics-json')?.textContent || '[]'
  );

  let currentObserver = null;

  // --- Enter Doc Mode ---
  function openDoc(topicId) {
    const topic = topicsMeta.find(t => t.id === topicId);
    if (!topic) return;

    // 1. Hide landing & canvas, show doc viewer
    landingSections.style.display = 'none';
    canvasSection.style.display = 'none';
    docViewer.style.display = '';

    // 2. Switch nav to doc mode
    navLanding.classList.add('hidden');
    navDoc.classList.add('active');
    if (navToggle) navToggle.classList.add('hidden');

    // 3. Set nav breadcrumb
    navBreadcrumb.innerHTML = topic.breadcrumb
      .map((crumb, i, arr) => {
        const isLast = i === arr.length - 1;
        return `<span class="${isLast ? 'bc-current' : ''}">${crumb}</span>${!isLast ? '<span class="bc-sep">/</span>' : ''}`;
      })
      .join('');

    // 4. Set doc breadcrumbs (inside content)
    docBreadcrumbs.innerHTML = topic.breadcrumb
      .map((crumb, i, arr) => {
        const isLast = i === arr.length - 1;
        return `<span${isLast ? ' style="color:var(--text-primary)"' : ''}>${crumb}</span>${!isLast ? '<span style="color:var(--text-ghost)">/</span>' : ''}`;
      })
      .join('');

    // 5. Toggle doc pages — show only the selected one
    document.querySelectorAll('[data-doc-page]').forEach(el => {
      el.style.display = el.getAttribute('data-doc-page') === topicId ? '' : 'none';
    });

    // 6. Toggle TOC — show only the selected one (desktop sidebar)
    document.querySelectorAll('[data-toc-for]').forEach(el => {
      el.style.display = el.getAttribute('data-toc-for') === topicId ? '' : 'none';
    });

    // 6b. Toggle mobile TOC — show only the selected one
    document.querySelectorAll('[data-toc-mobile-for]').forEach(el => {
      el.style.display = el.getAttribute('data-toc-mobile-for') === topicId ? '' : 'none';
    });

    // 7. Scroll to top
    window.scrollTo(0, 0);

    // 8. Update URL hash
    history.pushState({ topicId }, '', '#doc/' + topicId);

    // 9. Re-init icons
    if (typeof lucide !== 'undefined') lucide.createIcons();

    // 10. Setup scroll spy for TOC
    setupScrollSpy(topicId);

    // 11. Close mobile TOC if it was open
    closeMobileToc();
  }

  // --- Exit Doc Mode (back to Landing) ---
  function closeDoc() {
    // 1. Show landing, hide doc viewer
    landingSections.style.display = '';
    docViewer.style.display = 'none';

    // 2. Switch nav to landing mode
    navLanding.classList.remove('hidden');
    navDoc.classList.remove('active');
    if (navToggle) navToggle.classList.remove('hidden');

    // 3. Clear URL hash
    history.pushState(null, '', window.location.pathname);

    // 4. Scroll to library section
    setTimeout(() => {
      document.getElementById('library')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 50);

    // 5. Cleanup observer
    if (currentObserver) {
      currentObserver.disconnect();
      currentObserver = null;
    }

    // 6. Close mobile TOC
    closeMobileToc();

    // 7. Re-init icons
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  // --- Enter Canvas Mode ---
  function openCanvas() {
    landingSections.style.display = 'none';
    docViewer.style.display = 'none';
    canvasSection.style.display = '';

    navLanding.classList.add('hidden');
    navDoc.classList.remove('active');
    if (navToggle) navToggle.classList.add('hidden');

    // Close mobile menu if open
    const mobileMenu = document.getElementById('nav-mobile');
    if (mobileMenu) mobileMenu.classList.add('hidden');

    // Cleanup doc observer
    if (currentObserver) { currentObserver.disconnect(); currentObserver = null; }

    window.scrollTo(0, 0);
    history.pushState({ canvas: true }, '', '#canvas');

    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  // --- Exit Canvas Mode ---
  function closeCanvas() {
    canvasSection.style.display = 'none';
    landingSections.style.display = '';
    docViewer.style.display = 'none';

    navLanding.classList.remove('hidden');
    navDoc.classList.remove('active');
    if (navToggle) navToggle.classList.remove('hidden');

    history.pushState(null, '', window.location.pathname);

    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  // --- Scroll Spy for TOC ---
  function setupScrollSpy(topicId) {
    if (currentObserver) currentObserver.disconnect();

    const activePage = document.querySelector(`[data-doc-page="${topicId}"]`);
    if (!activePage) return;

    const sections = activePage.querySelectorAll('section[id]');
    if (!sections.length) return;

    const tocLinks = document.querySelectorAll(`[data-toc-for="${topicId}"] [data-toc-link]`);

    currentObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            // Desktop TOC
            tocLinks.forEach(link => {
              link.classList.toggle(
                'docviewer__toc-link--active',
                link.getAttribute('data-toc-link') === id
              );
            });
            // Mobile TOC
            const mobileTocLinks = document.querySelectorAll(`[data-toc-mobile-for="${topicId}"] [data-toc-mobile-link]`);
            mobileTocLinks.forEach(link => {
              link.classList.toggle(
                'docviewer__toc-link--active',
                link.getAttribute('data-toc-mobile-link') === id
              );
            });
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    sections.forEach(s => currentObserver.observe(s));
  }

  // --- Event: Card click (from Library.astro) ---
  document.addEventListener('topic:select', (e) => {
    openDoc(e.detail.topicId);
  });

  // --- Mobile TOC: open/close ---
  function openMobileToc() {
    mobileTocPanel?.classList.add('active');
    mobileTocOverlay?.classList.add('active');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function closeMobileToc() {
    mobileTocPanel?.classList.remove('active');
    mobileTocOverlay?.classList.remove('active');
  }

  mobileTocBtn?.addEventListener('click', openMobileToc);
  mobileTocClose?.addEventListener('click', closeMobileToc);
  mobileTocOverlay?.addEventListener('click', closeMobileToc);

  // --- Event: TOC link clicks (desktop + mobile) ---
  // Prevent default anchor navigation (which changes the URL hash and
  // breaks the #doc/topicId SPA routing). Use scrollIntoView instead.
  document.addEventListener('click', (e) => {
    const desktopLink = e.target.closest('[data-toc-link]');
    const mobileLink = e.target.closest('[data-toc-mobile-link]');
    const link = desktopLink || mobileLink;
    if (!link) return;

    e.preventDefault();

    const targetId = desktopLink
      ? link.getAttribute('data-toc-link')
      : link.getAttribute('data-toc-mobile-link');

    const targetEl = document.getElementById(targetId);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // Close mobile TOC panel if open
    if (mobileLink) {
      closeMobileToc();
    }
  });

  // --- Event: Back buttons ---
  navBack?.addEventListener('click', closeDoc);
  docBackSidebar?.addEventListener('click', closeDoc);
  docBackBottom?.addEventListener('click', closeDoc);
  canvasBack?.addEventListener('click', closeCanvas);

  // --- Event: Logo click returns to landing ---
  navLogo?.addEventListener('click', (e) => {
    if (docViewer.style.display !== 'none' || canvasSection.style.display !== 'none') {
      e.preventDefault();
      if (canvasSection.style.display !== 'none') {
        closeCanvas();
      } else {
        closeDoc();
      }
    }
  });

  // --- Event: Browser back/forward ---
  window.addEventListener('popstate', (e) => {
    if (e.state?.canvas) {
      openCanvas();
    } else if (e.state?.topicId) {
      openDoc(e.state.topicId);
    } else {
      // Going back to landing
      landingSections.style.display = '';
      docViewer.style.display = 'none';
      canvasSection.style.display = 'none';
      navLanding.classList.remove('hidden');
      navDoc.classList.remove('active');
      if (navToggle) navToggle.classList.remove('hidden');
      if (currentObserver) { currentObserver.disconnect(); currentObserver = null; }
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
  });

  // --- Event: Handle initial hash on page load ---
  function handleInitialHash() {
    const hash = window.location.hash;
    if (hash === '#canvas') {
      openCanvas();
      history.replaceState({ canvas: true }, '', '#canvas');
    } else if (hash.startsWith('#doc/')) {
      const topicId = hash.replace('#doc/', '');
      const topic = topicsMeta.find(t => t.id === topicId);
      if (topic) {
        openDoc(topicId);
        history.replaceState({ topicId }, '', hash);
      }
    }
  }

  handleInitialHash();

  // --- Event: Copy code button ---
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-copy-btn]');
    if (!btn) return;

    const codeBlock = btn.closest('.codeblock');
    const code = codeBlock?.querySelector('code')?.textContent || '';

    navigator.clipboard.writeText(code).then(() => {
      const icon = btn.querySelector('[data-lucide]');
      if (icon) {
        icon.setAttribute('data-lucide', 'check');
        if (typeof lucide !== 'undefined') lucide.createIcons();
        setTimeout(() => {
          icon.setAttribute('data-lucide', 'copy');
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }, 2000);
      }
    });
  });

  // --- Event: Ctrl+K to search (when in doc mode, go back first) ---
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      if (docViewer.style.display !== 'none') {
        closeDoc();
        setTimeout(() => {
          document.getElementById('library-search')?.focus();
        }, 400);
      } else {
        document.getElementById('library-search')?.focus();
      }
    }
  });

  // --- Event: Nav links for Canvas (#canvas) ---
  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href="#canvas"]');
    if (!link) return;
    e.preventDefault();
    openCanvas();
  });

  // --- Preload whiteboard iframe in background ---
  if (canvasIframe) {
    canvasIframe.src = '/whiteboard';
  }
})();
</script>
