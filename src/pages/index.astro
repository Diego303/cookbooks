---
/**
 * index.astro — Landing page.
 * Shows Hero → Library → Footer.
 * Documentation pages are now separate MPA routes at /doc/[slug].
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Library from '../components/Library.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Nav mode="landing" />
  <Hero />
  <Library />
  <Footer />
</Layout>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
// Redirect old hash-based URLs to new MPA paths
(function() {
  const hash = window.location.hash;
  if (hash.startsWith('#doc/')) {
    const slug = hash.replace('#doc/', '');
    window.location.replace(baseUrl + 'doc/' + slug);
  } else if (hash === '#canvas') {
    window.location.replace(baseUrl + 'canvas');
  }
})();
</script>
