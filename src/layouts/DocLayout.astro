---
/**
 * DocLayout — Layout for individual documentation pages (MPA).
 * Extracted from DocViewer.astro. Preserves the exact same visual structure:
 *   - Left sidebar: sticky TOC navigation
 *   - Right area: scrollable document content (native page scroll)
 *   - Mobile TOC: floating button + overlay panel
 */
import Layout from './Layout.astro';
import Nav from '../components/Nav.astro';

interface TocItem {
  id: string;
  label: string;
}

interface Props {
  title: string;
  description: string;
  intro: string;
  breadcrumb: string[];
  toc: TocItem[];
}

const { title, description, intro, breadcrumb, toc } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<Layout title={`${title} | Cookbooks`} description={description}>
  <Nav mode="doc" breadcrumb={breadcrumb} />

  <div class="docviewer">
    <div class="docviewer__shell">

      <!-- LEFT: Sticky sidebar -->
      <aside class="docviewer__sidebar custom-scroll">
        <a href={baseUrl} class="docviewer__sidebar-back">
          <i data-lucide="arrow-left" class="docviewer__sidebar-back-icon"></i>
          Volver a Librería
        </a>

        <div class="docviewer__sidebar-divider"></div>

        <div class="docviewer__toc-label">En esta página</div>

        <nav class="docviewer__toc" aria-label={`Tabla de contenidos: ${title}`}>
          {toc.map((item, idx) => (
            <a
              href={`#${item.id}`}
              class={`docviewer__toc-link ${idx === 0 ? 'docviewer__toc-link--active' : ''}`}
              data-toc-link={item.id}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="docviewer__sidebar-note">
          <i data-lucide="pin" class="docviewer__sidebar-note-pin"></i>
          <p>Pulsa <kbd>Ctrl+K</kbd> para buscar en toda la librería.</p>
        </div>
      </aside>

      <!-- MOBILE TOC: floating button + overlay (visible <1024px) -->
      <div class="docviewer__mobile-toc">
        <button class="docviewer__mobile-toc-btn" id="doc-mobile-toc-btn" aria-label="Tabla de contenidos">
          <i data-lucide="list" class="docviewer__mobile-toc-btn-icon"></i>
          <span>En esta página</span>
        </button>

        <div class="docviewer__mobile-toc-overlay" id="doc-mobile-toc-overlay"></div>

        <div class="docviewer__mobile-toc-panel" id="doc-mobile-toc-panel">
          <div class="docviewer__mobile-toc-panel-header">
            <span class="docviewer__toc-label">En esta página</span>
            <button class="docviewer__mobile-toc-close" id="doc-mobile-toc-close" aria-label="Cerrar">
              <i data-lucide="x" class="docviewer__mobile-toc-close-icon"></i>
            </button>
          </div>

          <nav class="docviewer__toc docviewer__toc--mobile">
            {toc.map((item, idx) => (
              <a
                href={`#${item.id}`}
                class={`docviewer__toc-link ${idx === 0 ? 'docviewer__toc-link--active' : ''}`}
                data-toc-mobile-link={item.id}
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      </div>

      <!-- RIGHT: Document content (native page scroll) -->
      <main class="docviewer__main">
        <!-- Breadcrumbs -->
        <div class="docviewer__breadcrumbs">
          {breadcrumb.map((crumb, i) => (
            <>
              <span style={i === breadcrumb.length - 1 ? 'color:var(--text-primary)' : ''}>
                {crumb}
              </span>
              {i < breadcrumb.length - 1 && <span style="color:var(--text-ghost)">/</span>}
            </>
          ))}
        </div>

        <!-- Doc content from MDX -->
        <article class="doc-article">
          <h1 class="doc-article__title">{title}</h1>
          <p class="doc-article__intro" set:html={intro} />
          <slot />
        </article>

        <!-- End of document -->
        <div class="docviewer__end">
          <div class="docviewer__end-rule">
            <span class="docviewer__end-label">END OF DOCUMENT</span>
          </div>
          <p class="docviewer__end-text">
            ¿Necesitas más?
            <a href={`${baseUrl}#library`} class="docviewer__end-link">Volver a la Librería &rarr;</a>
          </p>
        </div>
      </main>
    </div>
  </div>
</Layout>

<script is:inline define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
(function () {
  // --- Scroll Spy for TOC ---
  const sections = document.querySelectorAll('article.doc-article section[id]');
  const tocLinks = document.querySelectorAll('[data-toc-link]');
  const mobileTocLinks = document.querySelectorAll('[data-toc-mobile-link]');

  if (sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const id = entry.target.id;
            tocLinks.forEach(link => {
              link.classList.toggle(
                'docviewer__toc-link--active',
                link.getAttribute('data-toc-link') === id
              );
            });
            mobileTocLinks.forEach(link => {
              link.classList.toggle(
                'docviewer__toc-link--active',
                link.getAttribute('data-toc-mobile-link') === id
              );
            });
          }
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );
    sections.forEach(s => observer.observe(s));
  }

  // --- TOC link smooth scroll (prevent hash change) ---
  document.addEventListener('click', (e) => {
    const desktopLink = e.target.closest('[data-toc-link]');
    const mobileLink = e.target.closest('[data-toc-mobile-link]');
    const link = desktopLink || mobileLink;
    if (!link) return;

    e.preventDefault();
    const targetId = desktopLink
      ? link.getAttribute('data-toc-link')
      : link.getAttribute('data-toc-mobile-link');
    const targetEl = document.getElementById(targetId);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    if (mobileLink) closeMobileToc();
  });

  // --- Mobile TOC ---
  const mobileTocBtn = document.getElementById('doc-mobile-toc-btn');
  const mobileTocPanel = document.getElementById('doc-mobile-toc-panel');
  const mobileTocOverlay = document.getElementById('doc-mobile-toc-overlay');
  const mobileTocClose = document.getElementById('doc-mobile-toc-close');

  function openMobileToc() {
    mobileTocPanel?.classList.add('active');
    mobileTocOverlay?.classList.add('active');
    if (typeof lucide !== 'undefined') lucide.createIcons();
  }

  function closeMobileToc() {
    mobileTocPanel?.classList.remove('active');
    mobileTocOverlay?.classList.remove('active');
  }

  mobileTocBtn?.addEventListener('click', openMobileToc);
  mobileTocClose?.addEventListener('click', closeMobileToc);
  mobileTocOverlay?.addEventListener('click', closeMobileToc);

  // --- Copy code button ---
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-copy-btn]');
    if (!btn) return;
    const codeBlock = btn.closest('.codeblock');
    const code = codeBlock?.querySelector('code')?.textContent || '';
    navigator.clipboard.writeText(code).then(() => {
      const icon = btn.querySelector('[data-lucide]');
      if (icon) {
        icon.setAttribute('data-lucide', 'check');
        if (typeof lucide !== 'undefined') lucide.createIcons();
        setTimeout(() => {
          icon.setAttribute('data-lucide', 'copy');
          if (typeof lucide !== 'undefined') lucide.createIcons();
        }, 2000);
      }
    });
  });

  // --- Ctrl+K shortcut -> go to library ---
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      window.location.href = baseUrl + '#library';
    }
  });
})();
</script>

<style>
  /* ===== FULL-PAGE DOC VIEWER ===== */
  .docviewer {
    padding-top: 64px;
    min-height: 100vh;
    background: var(--bg-void);
    animation: docviewer-enter 0.4s ease-out both;
  }

  @keyframes docviewer-enter {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .docviewer__shell {
    display: flex;
    min-height: calc(100vh - 64px);
  }

  /* --- SIDEBAR --- */
  .docviewer__sidebar {
    display: none;
    width: 260px;
    flex-shrink: 0;
    position: sticky;
    top: 64px;
    height: calc(100vh - 64px);
    overflow-y: auto;
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    border-right: 1px solid var(--border-default);
    background: rgba(12, 12, 14, 1);
  }

  @media (min-width: 1024px) {
    .docviewer__sidebar { display: flex; flex-direction: column; }
  }

  .docviewer__sidebar-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    padding: 0.5rem 0;
    transition: color 0.2s;
    width: 100%;
  }

  .docviewer__sidebar-back:hover { color: var(--accent-cyan); }
  .docviewer__sidebar-back-icon { width: 14px; height: 14px; }

  .docviewer__sidebar-divider {
    height: 1px;
    background: var(--border-default);
    margin: var(--space-md) 0;
  }

  .docviewer__toc-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-dim);
    margin-bottom: 0.75rem;
  }

  .docviewer__toc {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-left: 1px solid var(--border-default);
    margin-bottom: auto;
  }

  .docviewer__toc-link {
    display: block;
    padding: 0.5rem 0 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: all 0.15s;
  }

  .docviewer__toc-link:hover {
    color: white;
    border-left-color: var(--text-dim);
  }

  .docviewer__toc-link--active {
    color: var(--accent-cyan) !important;
    border-left-color: var(--accent-cyan) !important;
    background: linear-gradient(to right, rgba(34, 211, 238, 0.06), transparent);
  }

  .docviewer__sidebar-note {
    position: relative;
    margin-top: var(--space-xl);
    padding: 0.875rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }

  .docviewer__sidebar-note-pin {
    position: absolute;
    top: -8px;
    right: -4px;
    width: 16px;
    height: 16px;
    color: var(--accent-pink);
    transform: rotate(12deg);
    fill: currentColor;
  }

  .docviewer__sidebar-note p {
    font-family: var(--font-hand);
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.5;
  }

  .docviewer__sidebar-note kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    background: var(--bg-code);
    border: 1px solid var(--border-default);
    padding: 0.0625rem 0.375rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  /* --- MAIN CONTENT --- */
  .docviewer__main {
    flex: 1;
    min-width: 0;
    max-width: 52rem;
    padding: var(--space-2xl) var(--space-lg);
    margin: 0 auto;
  }

  @media (min-width: 768px) {
    .docviewer__main { padding: var(--space-2xl) var(--space-3xl); }
  }

  @media (min-width: 1024px) {
    .docviewer__main { margin: 0; padding: var(--space-2xl) var(--space-3xl) var(--space-4xl); }
  }

  .docviewer__breadcrumbs {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
  }

  .docviewer__end {
    margin-top: var(--space-4xl);
    text-align: center;
  }

  .docviewer__end-rule {
    position: relative;
    border-top: 1px dashed var(--border-default);
    margin-bottom: var(--space-xl);
  }

  .docviewer__end-label {
    position: absolute;
    top: -0.625rem;
    left: 50%;
    transform: translateX(-50%);
    background: var(--bg-void);
    padding-inline: 1rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--text-ghost);
  }

  .docviewer__end-text {
    font-family: var(--font-hand);
    font-size: 1.25rem;
    color: var(--text-muted);
  }

  .docviewer__end-link {
    color: var(--accent-yellow);
    text-decoration: underline;
    text-decoration-style: wavy;
    text-underline-offset: 4px;
    font-family: inherit;
    font-size: inherit;
    transition: color 0.2s;
  }

  .docviewer__end-link:hover { color: white; }

  /* --- MOBILE TOC --- */
  .docviewer__mobile-toc { display: block; }

  @media (min-width: 1024px) {
    .docviewer__mobile-toc { display: none; }
  }

  .docviewer__mobile-toc-btn {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    transition: all 0.2s;
  }

  .docviewer__mobile-toc-btn:hover {
    border-color: var(--accent-cyan);
    color: white;
  }

  .docviewer__mobile-toc-btn-icon { width: 16px; height: 16px; }

  .docviewer__mobile-toc-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 45;
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .docviewer__mobile-toc-overlay.active { display: block; }

  .docviewer__mobile-toc-panel {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-default);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding: var(--space-lg);
    max-height: 60vh;
    overflow-y: auto;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .docviewer__mobile-toc-panel.active { transform: translateY(0); }

  .docviewer__mobile-toc-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-default);
  }

  .docviewer__mobile-toc-close {
    display: flex;
    align-items: center;
    color: var(--text-muted);
    padding: 0.25rem;
    transition: color 0.2s;
  }

  .docviewer__mobile-toc-close:hover { color: white; }
  .docviewer__mobile-toc-close-icon { width: 18px; height: 18px; }

  .docviewer__toc--mobile .docviewer__toc-link {
    padding: 0.625rem 0 0.625rem 1rem;
    font-size: 0.9375rem;
  }

  /* === SHARED DOC ARTICLE STYLES === */
  .docviewer__main :global(.doc-article__title) {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  .docviewer__main :global(.doc-article__intro) {
    font-size: 1.125rem;
    font-weight: 300;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    border-bottom: 1px dashed var(--border-default);
    padding-bottom: 2rem;
  }

  .docviewer__main :global(.doc-article__h2) {
    font-size: 1.5rem;
    font-weight: 600;
    color: white;
    margin-top: 3rem;
    margin-bottom: 1rem;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--border-default);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    scroll-margin-top: 5rem;
  }

  .docviewer__main :global(.doc-article section:first-of-type .doc-article__h2) {
    border-top: none;
    padding-top: 0;
    margin-top: 0;
  }

  .docviewer__main :global(.doc-article__h3) {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 5rem;
  }

  .docviewer__main :global(.doc-article__badge) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--text-secondary);
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }

  .docviewer__main :global(p) {
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .docviewer__main :global(strong) {
    color: white;
    font-weight: 500;
  }

  /* Inline code (markdown backticks) */
  .docviewer__main :global(code:not(pre code)) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    color: var(--accent-pink);
  }

  /* Legacy inline code classes (for HTML in MDX) */
  .docviewer__main :global(.doc-inline-code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    color: var(--accent-pink);
  }

  .docviewer__main :global(.doc-inline-code--cyan) { color: var(--accent-cyan); }
  .docviewer__main :global(.doc-inline-code--pink) { color: var(--accent-pink); }
  .docviewer__main :global(.doc-inline-code--green) { color: var(--accent-green); }

  /* Tables */
  .docviewer__main :global(.doc-table-wrapper) {
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin-block: 1rem;
  }

  .docviewer__main :global(.doc-table) {
    width: 100%;
    text-align: left;
    font-size: 0.875rem;
    border-collapse: collapse;
  }

  .docviewer__main :global(.doc-table thead) {
    background: var(--bg-surface);
    border-bottom: 1px solid var(--border-default);
  }

  .docviewer__main :global(.doc-table th) {
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    padding: 0.75rem 1rem;
  }

  .docviewer__main :global(.doc-table td) {
    padding: 0.75rem 1rem;
    color: var(--text-secondary);
    border-bottom: 1px dashed var(--border-default);
  }

  .docviewer__main :global(.doc-table tbody tr:last-child td) { border-bottom: none; }

  .docviewer__main :global(.doc-table tbody tr:hover) {
    background: rgba(24, 24, 27, 0.5);
  }

  .docviewer__main :global(.doc-method) {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: rgba(0, 0, 0, 0.3);
    padding: 0.125rem 0.375rem;
    border-radius: var(--radius-sm);
    margin-right: 0.25rem;
  }

  .docviewer__main :global(.doc-image) { margin-block: 1.5rem; }

  .docviewer__main :global(.doc-list) { margin-block: 1rem; }

  .docviewer__main :global(.doc-list li) {
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .docviewer__main :global(.doc-article__subsection-title) {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    scroll-margin-top: 5rem;
  }

  /* Shiki code block overrides */
  .docviewer__main :global(pre.astro-code) {
    background-color: transparent !important;
    margin: 0;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.7;
    white-space: pre;
  }

  .docviewer__main :global(pre.astro-code code) {
    font-family: inherit;
  }
</style>
