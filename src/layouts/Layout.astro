---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Cookbooks | Apuntes de Ingeniería',
  description = 'Documentación técnica con alma de cuaderno de ingeniería.',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Patrick+Hand&family=Permanent+Marker&display=swap"
    rel="stylesheet"
  />

  <!-- Lucide Icons -->
  <script is:inline src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
  <div class="bg-dots" aria-hidden="true"></div>
  <slot />
  <script is:inline>
    // Initialize Lucide icons on load and after any Astro navigation
    function initIcons() {
      if (typeof lucide !== 'undefined') lucide.createIcons();
    }
    document.addEventListener('DOMContentLoaded', initIcons);
    document.addEventListener('astro:page-load', initIcons);
  </script>
</body>
</html>
