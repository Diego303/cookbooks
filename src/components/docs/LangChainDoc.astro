---
import CodeBlock from '../CodeBlock.astro';
import Callout from '../Callout.astro';
import DocSection from '../DocSection.astro';
import DocImage from '../DocImage.astro';
import DocList from '../DocList.astro';
---

<article class="doc-article">
  <h1 class="doc-article__title">LangChain Agents</h1>

  <p class="doc-article__intro">
    Guía completa de creación de agentes inteligentes con LangChain y LangGraph.
    Cubre desde agentes básicos con tools hasta flujos multi-paso con LangGraph,
    memoria persistente, RAG y deployment.
  </p>

  <!-- LangChain Basics -->
  <section id="langchain-basics">
    <h2 class="doc-article__h2">LangChain Basics</h2>
    <p>
      LangChain proporciona abstracciones para interactuar con LLMs: <strong>prompts</strong>,
      <strong>chains</strong>, <strong>tools</strong> y <strong>agents</strong>. El flujo básico
      es: input → prompt → LLM → output parser.
    </p>

    <CodeBlock lang="text">
      <Fragment set:html={`<span class="token-comment">Componentes de LangChain</span>

┌─────────────────────────────────────────────────────────┐
│                    <span class="token-func">LangChain Stack</span>                      │
│                                                         │
│  ┌──────────┐  ┌────────────┐  ┌──────────────────────┐ │
│  │ <span class="token-string">Prompts</span>  │  │  <span class="token-string">Models</span>    │  │  <span class="token-string">Output Parsers</span>      │ │
│  │ Templates│  │  ChatGPT  │  │  JSON, Pydantic     │ │
│  │ Few-shot │  │  Claude   │  │  Structured Output  │ │
│  └──────────┘  │  Ollama   │  └──────────────────────┘ │
│                └────────────┘                           │
│  ┌──────────┐  ┌────────────┐  ┌──────────────────────┐ │
│  │ <span class="token-string">Chains</span>   │  │  <span class="token-string">Agents</span>   │  │  <span class="token-string">Memory</span>             │ │
│  │ LCEL     │  │  ReAct    │  │  Buffer, Summary    │ │
│  │ RunnableS│  │  Tools    │  │  Redis, PostgreSQL  │ │
│  └──────────┘  └────────────┘  └──────────────────────┘ │
│  ┌──────────────────────────────────────────────┐       │
│  │  <span class="token-string">Retrievers</span> — Vector stores, BM25, Ensemble  │       │
│  └──────────────────────────────────────────────┘       │
└─────────────────────────────────────────────────────────┘`} />
    </CodeBlock>

    <CodeBlock lang="python">
      <Fragment set:html={`<span class="token-keyword">from</span> langchain_openai <span class="token-keyword">import</span> ChatOpenAI
<span class="token-keyword">from</span> langchain_core.prompts <span class="token-keyword">import</span> ChatPromptTemplate
<span class="token-keyword">from</span> langchain_core.output_parsers <span class="token-keyword">import</span> StrOutputParser

<span class="token-comment"># ── Chain básico con LCEL (LangChain Expression Language) ──</span>
llm = <span class="token-func">ChatOpenAI</span>(model=<span class="token-string">"gpt-4o"</span>, temperature=<span class="token-string">0</span>)

prompt = ChatPromptTemplate.<span class="token-func">from_messages</span>([
    (<span class="token-string">"system"</span>, <span class="token-string">"Eres un asistente técnico experto en {domain}."</span>),
    (<span class="token-string">"human"</span>, <span class="token-string">"{question}"</span>),
])

<span class="token-comment"># LCEL: pipe operator para componer componentes</span>
chain = prompt | llm | <span class="token-func">StrOutputParser</span>()

<span class="token-comment"># Invocar</span>
response = chain.<span class="token-func">invoke</span>({
    <span class="token-string">"domain"</span>: <span class="token-string">"Kubernetes"</span>,
    <span class="token-string">"question"</span>: <span class="token-string">"¿Cómo funciona el HPA?"</span>,
})`} />
    </CodeBlock>
  </section>

  <!-- Tools & Function Calling -->
  <section id="tools-function-calling">
    <h2 class="doc-article__h2">Tools & Function Calling</h2>
    <p>
      Las <strong>tools</strong> extienden al LLM con capacidades del mundo real: consultar
      bases de datos, llamar APIs, ejecutar código, buscar documentos, etc.
    </p>

    <CodeBlock lang="python">
      <Fragment set:html={`<span class="token-keyword">from</span> langchain_core.tools <span class="token-keyword">import</span> tool
<span class="token-keyword">from</span> langchain_openai <span class="token-keyword">import</span> ChatOpenAI

<span class="token-comment"># ── Definir tools ──</span>
@<span class="token-func">tool</span>
<span class="token-keyword">def</span> <span class="token-func">search_database</span>(query: <span class="token-keyword">str</span>) -> <span class="token-keyword">str</span>:
    <span class="token-string">"""Busca información en la base de datos. Usar para consultas de datos."""</span>
    <span class="token-comment"># Ejecutar query SQL...</span>
    <span class="token-keyword">return</span> f<span class="token-string">"Resultados para: {query}"</span>

@<span class="token-func">tool</span>
<span class="token-keyword">def</span> <span class="token-func">send_email</span>(to: <span class="token-keyword">str</span>, subject: <span class="token-keyword">str</span>, body: <span class="token-keyword">str</span>) -> <span class="token-keyword">str</span>:
    <span class="token-string">"""Envía un email. Usar cuando el usuario pida notificar a alguien."""</span>
    <span class="token-comment"># Enviar email...</span>
    <span class="token-keyword">return</span> f<span class="token-string">"Email enviado a {to}"</span>

@<span class="token-func">tool</span>
<span class="token-keyword">def</span> <span class="token-func">get_weather</span>(city: <span class="token-keyword">str</span>) -> <span class="token-keyword">str</span>:
    <span class="token-string">"""Obtiene el clima actual de una ciudad."""</span>
    <span class="token-comment"># Llamar API de clima...</span>
    <span class="token-keyword">return</span> f<span class="token-string">"Clima en {city}: 22°C, soleado"</span>

<span class="token-comment"># ── Crear agente con tools ──</span>
llm = <span class="token-func">ChatOpenAI</span>(model=<span class="token-string">"gpt-4o"</span>)
llm_with_tools = llm.<span class="token-func">bind_tools</span>([search_database, send_email, get_weather])

<span class="token-comment"># El LLM decide qué tool usar basándose en la pregunta</span>
response = llm_with_tools.<span class="token-func">invoke</span>(<span class="token-string">"¿Qué clima hace en Madrid?"</span>)
<span class="token-func">print</span>(response.tool_calls)
<span class="token-comment"># [{'name': 'get_weather', 'args': {'city': 'Madrid'}}]</span>`} />
    </CodeBlock>

    <Callout type="tip" title="Docstrings de tools">
      El LLM usa el <strong>docstring</strong> de cada tool para decidir cuándo usarla.
      Escribe docstrings claros y específicos. Incluye cuándo usar la tool y cuándo no.
    </Callout>
  </section>

  <!-- LangGraph Workflows -->
  <section id="langgraph-workflows">
    <h2 class="doc-article__h2">LangGraph Workflows</h2>
    <p>
      LangGraph construye agentes como <strong>grafos de estados</strong> con ciclos y
      branching. Es la evolución de los agents legacy de LangChain, con control explícito
      del flujo de ejecución.
    </p>

    <CodeBlock lang="text">
      <Fragment set:html={`<span class="token-comment">Flujo de un agente LangGraph (ReAct pattern)</span>

                    ┌─────────────┐
                    │   <span class="token-func">START</span>      │
                    └──────┬──────┘
                           │
                    ┌──────▼──────┐
             ┌─────│   <span class="token-string">Reason</span>    │◀────────────┐
             │     │  (LLM call) │             │
             │     └──────┬──────┘             │
             │            │                    │
             │     ┌──────▼──────┐             │
             │     │  ¿Tool call?│             │
             │     └──┬──────┬───┘             │
             │   No   │      │  Sí             │
             │        │      │                 │
      ┌──────▼──┐     │  ┌───▼─────────┐      │
      │  <span class="token-keyword">END</span>    │     │  │ <span class="token-string">Execute</span>     │      │
      │(respond)│     │  │ <span class="token-string">Tool(s)</span>     │──────┘
      └─────────┘     │  └─────────────┘
                      │
               ┌──────▼──┐
               │  <span class="token-keyword">END</span>    │
               │(respond)│
               └─────────┘`} />
    </CodeBlock>

    <CodeBlock lang="python">
      <Fragment set:html={`<span class="token-keyword">from</span> langgraph.graph <span class="token-keyword">import</span> StateGraph, MessagesState, START, END
<span class="token-keyword">from</span> langgraph.prebuilt <span class="token-keyword">import</span> ToolNode, tools_condition
<span class="token-keyword">from</span> langchain_openai <span class="token-keyword">import</span> ChatOpenAI

<span class="token-comment"># ── Definir modelo y tools ──</span>
llm = <span class="token-func">ChatOpenAI</span>(model=<span class="token-string">"gpt-4o"</span>)
tools = [search_database, get_weather, send_email]
llm_with_tools = llm.<span class="token-func">bind_tools</span>(tools)

<span class="token-comment"># ── Nodo de reasoning ──</span>
<span class="token-keyword">def</span> <span class="token-func">reasoning_node</span>(state: MessagesState):
    response = llm_with_tools.<span class="token-func">invoke</span>(state[<span class="token-string">"messages"</span>])
    <span class="token-keyword">return</span> {<span class="token-string">"messages"</span>: [response]}

<span class="token-comment"># ── Construir grafo ──</span>
graph = <span class="token-func">StateGraph</span>(MessagesState)
graph.<span class="token-func">add_node</span>(<span class="token-string">"reason"</span>, reasoning_node)
graph.<span class="token-func">add_node</span>(<span class="token-string">"tools"</span>, <span class="token-func">ToolNode</span>(tools))

<span class="token-comment"># Flujo: START → reason → [tools → reason] → END</span>
graph.<span class="token-func">add_edge</span>(START, <span class="token-string">"reason"</span>)
graph.<span class="token-func">add_conditional_edges</span>(<span class="token-string">"reason"</span>, tools_condition)
graph.<span class="token-func">add_edge</span>(<span class="token-string">"tools"</span>, <span class="token-string">"reason"</span>)

<span class="token-comment"># Compilar</span>
agent = graph.<span class="token-func">compile</span>()

<span class="token-comment"># Ejecutar</span>
result = agent.<span class="token-func">invoke</span>({
    <span class="token-string">"messages"</span>: [(<span class="token-string">"human"</span>, <span class="token-string">"¿Qué clima hace en Tokyo?"</span>)]
})`} />
    </CodeBlock>
  </section>

  <!-- Memory & Persistence -->
  <section id="memory-persistence">
    <h2 class="doc-article__h2">Memory & Persistence</h2>
    <p>
      Los agentes necesitan memoria para mantener contexto entre conversaciones.
      LangGraph soporta <strong>checkpointing</strong> para persistir el estado del grafo.
    </p>

    <CodeBlock lang="python">
      <Fragment set:html={`<span class="token-keyword">from</span> langgraph.checkpoint.postgres <span class="token-keyword">import</span> PostgresSaver

<span class="token-comment"># ── Persistir estado en PostgreSQL ──</span>
DB_URI = <span class="token-string">"postgresql://user:pass@localhost/agents"</span>

<span class="token-keyword">with</span> <span class="token-func">PostgresSaver.from_conn_string</span>(DB_URI) <span class="token-keyword">as</span> checkpointer:
    agent = graph.<span class="token-func">compile</span>(checkpointer=checkpointer)

    <span class="token-comment"># Conversación con thread_id para identificar sesiones</span>
    config = {<span class="token-string">"configurable"</span>: {<span class="token-string">"thread_id"</span>: <span class="token-string">"user-123-session-1"</span>}}

    <span class="token-comment"># Primer mensaje</span>
    result = agent.<span class="token-func">invoke</span>(
        {<span class="token-string">"messages"</span>: [(<span class="token-string">"human"</span>, <span class="token-string">"Mi nombre es Diego"</span>)]},
        config,
    )

    <span class="token-comment"># Segundo mensaje — el agente recuerda el nombre</span>
    result = agent.<span class="token-func">invoke</span>(
        {<span class="token-string">"messages"</span>: [(<span class="token-string">"human"</span>, <span class="token-string">"¿Cómo me llamo?"</span>)]},
        config,
    )
    <span class="token-comment"># → "Tu nombre es Diego"</span>`} />
    </CodeBlock>

    <Callout type="info" title="Opciones de checkpointer">
      LangGraph ofrece checkpointers para <code>PostgreSQL</code>,
      <code>SQLite</code> y <code>Memory</code> (desarrollo).
      En producción, siempre usa PostgreSQL para durabilidad.
    </Callout>
  </section>

  <!-- RAG Integration -->
  <section id="rag-integration">
    <h2 class="doc-article__h2">RAG Integration</h2>
    <p>
      Retrieval-Augmented Generation (RAG) permite al agente consultar bases de conocimiento
      propias antes de responder, mejorando la precisión y reduciendo alucinaciones.
    </p>

    <CodeBlock lang="python">
      <Fragment set:html={`<span class="token-keyword">from</span> langchain_community.vectorstores <span class="token-keyword">import</span> Chroma
<span class="token-keyword">from</span> langchain_openai <span class="token-keyword">import</span> OpenAIEmbeddings
<span class="token-keyword">from</span> langchain_core.tools <span class="token-keyword">import</span> tool

<span class="token-comment"># ── Crear vector store ──</span>
embeddings = <span class="token-func">OpenAIEmbeddings</span>(model=<span class="token-string">"text-embedding-3-small"</span>)
vectorstore = Chroma.<span class="token-func">from_documents</span>(
    documents=docs,
    embedding=embeddings,
    persist_directory=<span class="token-string">"./chroma_db"</span>,
)
retriever = vectorstore.<span class="token-func">as_retriever</span>(search_kwargs={<span class="token-string">"k"</span>: <span class="token-string">5</span>})

<span class="token-comment"># ── Tool de RAG para el agente ──</span>
@<span class="token-func">tool</span>
<span class="token-keyword">def</span> <span class="token-func">search_knowledge_base</span>(query: <span class="token-keyword">str</span>) -> <span class="token-keyword">str</span>:
    <span class="token-string">"""Busca en la base de conocimiento interna. Usar para preguntas
    sobre documentación, políticas o procedimientos de la empresa."""</span>
    docs = retriever.<span class="token-func">invoke</span>(query)
    <span class="token-keyword">return</span> <span class="token-string">"\\n\\n"</span>.<span class="token-func">join</span>(d.page_content <span class="token-keyword">for</span> d <span class="token-keyword">in</span> docs)

<span class="token-comment"># Añadir la tool de RAG al agente</span>
tools = [search_knowledge_base, search_database, send_email]`} />
    </CodeBlock>
  </section>

  <!-- PLACEHOLDER -->
</article>
