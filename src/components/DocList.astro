---
/**
 * DocList — Styled list for documentation with configurable marker style.
 *
 * Renders a vertical list with decorative markers that match the design system.
 * Marker types: 'dash' (—), 'check' (✓), 'arrow' (→), 'dot' (•)
 *
 * @example
 * <DocList marker="check" items={[
 *   'First item',
 *   'Second item <code class="doc-inline-code">with code</code>',
 * ]} />
 *
 * Or use the slot for complex items:
 * <DocList marker="arrow">
 *   <li>Complex <strong>item</strong></li>
 * </DocList>
 */
interface Props {
  marker?: 'dash' | 'check' | 'arrow' | 'dot';
  items?: string[];
  color?: string;
}

const { marker = 'dash', items, color } = Astro.props;

const markerMap = {
  dash:  '—',
  check: '✓',
  arrow: '→',
  dot:   '•',
};

const colorMap = {
  dash:  'var(--text-dim)',
  check: 'var(--accent-green)',
  arrow: 'var(--accent-cyan)',
  dot:   'var(--text-dim)',
};

const markerChar = markerMap[marker];
const markerColor = color || colorMap[marker];
---

<ul class="doc-list" style={`--marker-char: "${markerChar}"; --marker-color: ${markerColor};`}>
  {items
    ? items.map(item => (
        <li><Fragment set:html={item} /></li>
      ))
    : <slot />
  }
</ul>

<style>
  .doc-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 1rem;
  }

  .doc-list li {
    position: relative;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.7;
    padding-left: 1.5rem;
  }

  .doc-list li::before {
    content: var(--marker-char);
    position: absolute;
    left: 0;
    color: var(--marker-color);
    font-weight: 700;
  }

  .doc-list li :global(strong) {
    color: var(--text-primary);
  }

  .doc-list li :global(code) {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    background: var(--bg-surface);
    border: 1px solid var(--border-default);
    padding: 0.0625rem 0.375rem;
    border-radius: var(--radius-sm);
    color: var(--accent-pink);
  }
</style>
